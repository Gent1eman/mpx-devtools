{
  "name": "mpx-devtools",
  "version": "0.0.0",
  "private": true,
  "description": "Source-level cross-platform debugging tools for Mpx.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "packages:list": "pnpm --recursive list --depth -1",
    "typecheck": "tsc --build",
    "test": "pnpm typecheck && vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
